# YatraLocal Environment Variables
# Copy to .env to configure optional real external providers.
# If omitted, YatraLocal runs in standalone zero-dependency offline mode with intelligent rule engine.

PORT=8000

# Phase 12: Real AI Provider (Optional)
# If provided, /api/plan and /api/chat will use this model.
# If omitted or offline, falls back to the local rule-based itinerary engine.
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Phase 13: Emergency SOS SMS/WhatsApp Provider (Optional)
# If provided, /api/sos will dispatch real alerts via Twilio.
# If omitted, falls back to SMS/WhatsApp deep links and browser native share.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
